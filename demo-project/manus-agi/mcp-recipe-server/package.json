{
  "name": "github-recipe-book-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for GitHub Recipe Book - scan repositories and generate compatibility recipes",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
